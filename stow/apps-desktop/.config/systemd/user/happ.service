[Unit]
Description=Happ
After=wayland-ready.target
# (start the target automatically when the service is enabled)
Requires=wayland-ready.target

[Service]
# Happ bundles libwayland-client 1.20; system mesa EGL needs the 1.23 symbol
# wl_display_create_queue_with_name. Preload the distro lib instead.
Environment=LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libwayland-client.so.0
ExecStart=/usr/bin/happ
Restart=no

[Install]
# start automatically when the target is reached
WantedBy=wayland-ready.target
