#!/usr/bin/env bash
# tuios appearance.link_opener: open a web link in terminal-browser.
# One browser serves the whole session: a click gives its tab the link, and
# when that pane sits on another workspace, switches to it. Only when the
# session has no browser does the daemon start one, in a new pane here.
# tuios starts the opener with no tty, so the daemon has to do the starting.
set -eo pipefail

url=${1:?usage: tuios-open URL}

case $url in
http://* | https://*) ;;
*) exec xdg-open "$url" ;; # mailto:, ftp:: the desktop owns those
esac

# The session's browser with the pane it runs in, that pane's workspace, ours.
key= win= bws= cur=
IFS=$'\t' read -r key win bws cur < <(
	tuios list-windows --json 2>/dev/null | jq -r --slurpfile b <(terminal-browser ls --all --json 2>/dev/null) '
		.current_workspace as $cur
		| first(.windows[] as $w
			| select($w.tty != null)
			| $b[0].browsers[] | select((.tty // null) == $w.tty)
			| [.key, $w.window_id, $w.workspace, $cur] | @tsv) // empty
	' 2>/dev/null
) || true

if [[ -n $key ]] && terminal-browser new-tab --browser "$key" "$url"; then
	[[ $bws == "$cur" ]] || tuios focus-window "$win"
	exit 0
fi

ws=()
[[ -n $cur ]] && ws=(--workspace "$cur")
exec tuios new-window web "${ws[@]}" -- terminal-browser open "$url"
