#!/usr/bin/env nu
#MISE description="Install the .debs declared in packages.toml via apt (dpkg-tracked, deps resolved)"
#MISE raw_args=true

# Apt has no notion of a local .deb, so a release that only ships one cannot be
# declared in [bootstrap.packages] ([deb] in packages.toml). This fetches them
# and hands them to apt, which keeps owning the package afterwards
# (`apt remove <pkg>` works and mise never claims to have installed it).
const Plan = 'packages.toml'
# Repo-local and gitignored. World-readable, so apt's _apt sandbox can read it.
const Cache = '.cache/debs'

def main [] {
    let root = $env.MISE_PROJECT_ROOT
    let debs = (open ($root | path join $Plan) | get -o deb | default {})
    let cache = ($root | path join $Cache)
    mkdir $cache

    mut todo = []
    # Keys are free-form labels; the package name always comes from the .deb itself,
    # so dpkg/apt state is checked against what the file really installs.
    for entry in ($debs | items {|tag, url| { tag: $tag, url: $url } }) {
        # Hash the URL into the cache name
        let deb = ($cache | path join $"($entry.url | hash sha256 | str substring 0..8)-($entry.url | path basename)")
        if not ($deb | path exists) {
            # Download to .part and rename: a failed fetch must never be mistaken
            # for a cached .deb on the next run.
            let dl = (do { ^curl -fsSL --output $"($deb).part" $entry.url } | complete)
            if $dl.exit_code != 0 {
                rm -f $"($deb).part"
                error make { msg: $"($entry.tag): download failed: ($dl.stderr | str trim)" }
            }
            mv $"($deb).part" $deb
        }

        let ctl = (do { ^dpkg-deb -f $deb Package } | complete)
        if $ctl.exit_code != 0 {
            rm -f $deb
            error make { msg: $"($entry.tag): not a usable .deb, dropped from cache - re-run to refetch: ($ctl.stderr | str trim)" }
        }
        # One field at a time: dpkg-deb prefixes 'Field: ' when asked for several.
        let pkg = ($ctl.stdout | str trim)
        let ver = (^dpkg-deb -f $deb Version | str trim)
        if ($pkg | str contains ' ') or ($ver | str contains ' ') {
            error make { msg: $"($entry.tag): unparsable control fields '($pkg)' / '($ver)'" }
        }
        let have = (do { ^dpkg-query -W -f '${Version}' $pkg } | complete)
        if $have.exit_code == 0 and ($have.stdout | str trim) == $ver {
            print $"($entry.tag): ($pkg) ($ver) installed"
        } else {
            $todo = ($todo | append $deb)
        }
    }

    if ($todo | is-empty) { return }
    # apt, not dpkg: it resolves the debs' Depends from the configured archives.
    sudo apt-get install -y ...$todo
}
