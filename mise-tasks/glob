#!/usr/bin/env nu
#MISE description="Helper to run a task or a group of tasks"
#MISE raw_args=true

use std/log
$env.NU_LOG_FORMAT = "%ANSI_START%%LEVEL%: %MSG%%ANSI_STOP%"


def 'mise ls' []: nothing -> list<string> {
    let res = (^mise tasks ls --local --hidden --json | complete)
    if $res.exit_code != 0 {
      log error $res.stderr; exit $res.exit_code
    }
    $res.stdout | from json | get name
}

# Run a task or a group of tasks (helper)
#
# Example usage:
#   glob -p stow podman
#     - Effectively runs stow:podman or stow:podman:* (if it's a group of tasks)
#
#   glob -p setup foo bar
#     - Run multiple tasks with setup prefix
#
#   glob -p stow nest:task or glob -p stow:nest task
#     - Use nested task globing
def main [
    --prefix (-p): string         # Task prefix to run (eg: prefix:sub)
    ...tasks: string              # Specific tasks to execute podman, default-bundle etc
] {
    if ($prefix | is-empty) {
        log error "Prefix is required!"
        print -en (help main | to text); exit 1
    }

    # List all mise tasks
    let mise_tasks = (mise ls)

    # Locate by prefix and make unique
    let plan = ($tasks | each {|task|
            $mise_tasks | where {|i| $i | str starts-with $"($prefix):($task)" }
        } | flatten | uniq
    )

    # Execute all tasks in plan
    $plan | each {|task|
        try { ^mise run $task; 0 } catch { 1 }
    }
      | if ($in | any {|i| $i == 1}) { exit 1 }
}
