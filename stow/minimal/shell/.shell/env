#!/bin/sh
# vim: set filetype=sh:
# Session env, sourced by the login profiles and .zshrc. Stable paths only: a
# shell that never activates mise resolves versions at exec time via the shims.
#
. ~/.shell/lib

if [ -e '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh' ]; then
  . '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh'
fi

# Prepend: shims must beat /usr/bin; activate still precedes them in shells
_dot_prepend_paths "${HOME}/.local/share/mise/shims"

# nvim's mason bin (stylua, shfmt, lsp servers): nvim prepends it itself, nothing else does
_dot_append_paths \
  "${HOME}/.local/bin" \
  "${HOME}/.local/scripts" \
  "${KREW_ROOT:-$HOME/.krew}/bin" \
  "${XDG_DATA_HOME:-$HOME/.local/share}/nvim/mason/bin"

# `cargo install` lands here: mise provides cargo itself, not what it installs.
# Uncomment when a cargo-installed binary is actually in use.
# _dot_append_paths "${HOME}/.cargo/bin"

# pnpm globals: binaries from `pnpm add -g` land in PNPM_HOME
if command -v pnpm >/dev/null 2>&1; then
  export PNPM_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm"
  _dot_append_paths "$PNPM_HOME"
fi

# Docker clients (compose, buildx) talk to podman's compat socket
if command -v podman >/dev/null 2>&1; then
  export DOCKER_HOST=unix://$XDG_RUNTIME_DIR/podman/podman.sock
  export DOCKER_SOCK=$XDG_RUNTIME_DIR/podman/podman.sock
fi

export EDITOR=nvim
