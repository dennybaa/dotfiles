#!/bin/sh
# vim: set filetype=sh:
. ~/.shell/lib

# .profile sources this too, and a login can be non-interactive: tooling only when
# someone is at a prompt.
case $- in *i*) ;; *) return ;; esac

# Activate for supported shells
if shell_is zsh bash; then
  safe_eval mise activate "$_shell"
fi

if shell_is bash zsh; then
  safe_eval starship init $_shell
  safe_eval wt config shell init $_shell
fi

# Bash specific
case "$_shell" in
bash)
  safe_eval zoxide init --cmd ${ZOXIDE_CMD_OVERRIDE:-z} bash
  safe_eval fzf --bash
  ;;
esac

# fpath array: the assignment has to sit behind eval because this file is sh-sourced
if [ -n "${ZSH_VERSION:-}" ]; then
  eval 'fpath=("${HOME}/.nix-profile/share/zsh/site-functions" $fpath)'

  # Load antidote after fpath is set
  . ~/.shell/antidote
fi

source_on ~/.shell/functions bash zsh
source_on ~/.shell/completions bash zsh

# gpg needs a tty for pinentry-wukong
export GPG_TTY=$(tty)

alias ta="tmux a"
alias pa="pi --model longcat-2.5-free -p"
alias tui="TUIOS_CELL_FRAME=0 tuios"

# Caller runs unset_lib to clean up lib functions
