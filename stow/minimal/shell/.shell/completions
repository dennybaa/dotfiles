#!/bin/sh
# vim: set filetype=bash:
# Extra shell completions for zsh and bash — only for tools whose completions
# neither nix nor a newer mise (packslip) install ships. Written to disk, not eval'd.

gen_completion "gopass completion $_shell" "$_shell"
gen_completion "mise completion $_shell" "$_shell"
gen_completion "tuios completion $_shell" "$_shell"
