#!/usr/bin/env zsh
# Note! antidote uses .zsh_plugins.txt file
#
. ~/.shell/lib

_dot_define "_dot_add_colorize_progs"
_dot_add_colorize_progs() {
    for prog in "$@"; do
        function $prog() {
            \grc --colour=auto $0 "$@"
        }
    done
}

# Good ones: native, stata-dark, dracula
ZSH_COLORIZE_STYLE=stata-dark

# Colorize additional tools
_dot_add_colorize_progs ss

# Set oh-my-zsh update to auto mode
zstyle ':omz:update' mode auto

# Load antidote (the nix profile may not be installed yet, e.g. right after `mise run deploy`)
if [ -r ~/.nix-profile/share/antidote/antidote.zsh ]; then
  . ~/.nix-profile/share/antidote/antidote.zsh
  antidote load ${HOME}/.zsh_plugins.txt

  # zephyr completion style
  if (( $+functions[compstyleinit] )); then
    compstyleinit
    compstyle zephyr
  fi

  # plain group labels (fzf-tab can't expand %F), and no native menu (fzf-tab owns it)
  zstyle ':completion:*' format ' -- %d --'
  zstyle ':completion:*:descriptions' format ' -- %d --'
  zstyle ':completion:*:corrections' format ' -- %d (errors: %e) --'
  zstyle ':completion:*:*:*:*:*' menu no
  zstyle ':completion:*:*:cd:*:directory-stack' menu no
  zstyle ':completion:*:*:kill:*' menu no
  zstyle ':completion:*:man:*' menu no
fi
