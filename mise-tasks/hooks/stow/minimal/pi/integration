#!/usr/bin/env sh
#MISE hide=true

# tuios is a mise tool, so a first provision stows before it exists.
[ "${hookAction:-create}" = create ] || exit 0
command -v tuios >/dev/null 2>&1 || exit 0

# Quiet unless tuios wrote something: it reports each item on every run.
out=$(tuios integration install pi 2>&1) || {
	printf '%s\n' "$out"
	exit 1
}
[ -n "$out" ] && printf '%s\n' "$out" | grep -v 'already installed and current' || :
